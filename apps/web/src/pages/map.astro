---
// 로드맵 전체 (roadmap.sh): 레이어를 위(L0)에서 아래(L6)로 줄지어 놓고, 트랙 사이의 선수 관계를 선으로 잇는다.
// 트랙을 누르면 오른쪽 서랍에 핵심 질문·진도·의존 트랙과 로드맵 열기 버튼이 나온다.
import Shell from "../layouts/Shell.astro";
import { loadBook, allChapters, str } from "../lib/book";
import { chapterSummary, trackEdges } from "../lib/site";
import { coverSVG } from "../lib/cover";
const { parts, config } = loadBook();
const tracks = (config.tracks as any[]).filter((t) => t.layer < 9);
const layers = (config.layers as any[]).filter((l) => l.level < 9).sort((a, b) => a.level - b.level);
const count = (key: string) => parts.filter((p) => str(p.meta.track) === key).reduce((s, p) => s + p.chapters.length, 0);
const data = {
  tracks: tracks.map((t) => ({ key: t.key, code: t.code, name: t.name, question: t.question, outcome: t.outcome, layer: t.layer, n: count(t.key) })),
  edges: trackEdges(),
  chapters: allChapters().map(chapterSummary),
};
---
<Shell title="로드맵" current="map" description="트랙과 선수 관계를 레이어 순서로 펼친 전체 로드맵">
  <div>
    <div class="page-head">
      <h1>로드맵</h1>
      <p>위에서 아래로 내려갈수록 앞 레이어를 바탕으로 한다. 트랙을 누르면 연결이 드러난다.</p>
    </div>
    <div class="tmap" data-tmap>
      <svg class="links" aria-hidden="true"></svg>
      {layers.map((l) => (
        <div class="tmap-row">
          <div class="lv">L{l.level}<b>{l.name}</b></div>
          <div class="nodes">
            {tracks.filter((t) => t.layer === l.level).map((t) => (
              <button type="button" class="tnode" data-track={t.key} aria-pressed="false">
                <span class="thumb" set:html={coverSVG({ id: t.key, track: t.key, code: "", ratio: 1 })} />
                <span class="code">{t.code}</span>
                <b>{t.name}</b>
                <div class="progress"><i data-track-progress={t.key}></i></div>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
  <script type="application/json" id="map-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
  <script type="application/json" id="chapters-data" set:html={JSON.stringify(data.chapters).replace(/</g, "\\u003c")} />
</Shell>
