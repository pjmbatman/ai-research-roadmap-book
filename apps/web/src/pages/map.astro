---
import Shell from "../layouts/Shell.astro";
import { loadBook, allChapters, str } from "../lib/book";
const { parts, config } = loadBook();
const tracks = (config.tracks as any[]).map((t, i) => ({ ...t, i })).filter((t) => t.layer < 9).sort((a, b) => a.layer - b.layer || a.i - b.i);
const layers = (config.layers as any[]).filter((l) => l.level < 9);
const nodes = allChapters()
  .filter((c) => c.partSlug !== "appendices")
  .map((c) => ({
    id: c.id, label: c.label, title: str(c.meta.title), url: c.url, tier: str(c.meta.tier), status: str(c.meta.status),
    track: str(parts.find((p) => p.slug === c.partSlug)?.meta.track), pre: (c.meta.prerequisites as string[]) || [],
  }));
const data = { tracks: tracks.map((t) => ({ key: t.key, code: t.code, name: t.name, layer: t.layer })), layers: layers.map((l) => ({ level: l.level, name: l.name })), nodes };
---
<Shell title="로드맵 지도" current="map" description="장과 선수 지식 관계를 레이어·트랙 순서로 펼친 지도">
  <div class="page">
    <p class="eyebrow">선수 지식 그래프 · {nodes.length}개 장</p>
    <h1 style="font-size: clamp(32px, 5vw, 50px); margin: 6px 0 8px;">로드맵 지도</h1>
    <p style="color: var(--ink-2); max-width: 60ch; margin: 0 0 18px">열은 트랙, 왼쪽에서 오른쪽으로 갈수록 높은 레이어다. 장 위에 마우스를 올리면 그 장에 필요한 선수 지식(코랄)과 그 장을 선수로 하는 장(밝은 선)이 드러난다. 클릭하면 고정된다. 목록으로 보려면 <a href={import.meta.env.BASE_URL + "tracks/"}>트랙과 목차</a>를 쓴다.</p>
    <div class="map-wrap" data-map>
      <canvas aria-label="장과 선수 지식 관계 그래프. 같은 내용을 트랙과 목차 페이지에서 목록으로 볼 수 있다." role="img"></canvas>
      <div class="map-tools" role="group" aria-label="보기 설정">
        <button type="button" data-filter="all" aria-pressed="true">전체</button>
        <button type="button" data-filter="core" aria-pressed="false">필수만</button>
        <button type="button" data-filter="ready" aria-pressed="false">완성된 장</button>
        <button type="button" data-filter="visited" aria-pressed="false">내가 읽은 장</button>
      </div>
      <div class="map-info" data-map-info aria-live="polite"><span class="muted">장을 가리키거나 눌러 본다.</span></div>
    </div>
    <script type="application/json" id="map-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
  </div>
</Shell>
