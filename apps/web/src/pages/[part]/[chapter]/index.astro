---
// 장 페이지 (ADR 0012).
// 본문이 있는 장 = 퀘스트(Clay): 왼쪽 단원·학습 목표 · 가운데 구간 탭과 지그재그 길 · 오른쪽 진행·실습실·다음 장.
//   노드를 누르면 수업 시트가 뜨고 한 쪽씩 넘긴다. 절의 본문은 아래 보관함(data-store)에 그려 두고 시트로 옮겨 보인다.
// 목차 단계의 장: 학습 목표 카드 + 절별 카드 한 화면.
import Shell from "../../../layouts/Shell.astro";
import { allChapters, partOf, trackOfChapter, prerequisites, neighbors, STATUS_LABEL, str } from "../../../lib/book";
import { renderChapter, renderMarkdown, renderInline } from "../../../lib/markdown";
import { chapterData } from "../../../lib/page";
import { goalsOf, isReady, trackKeyOf, trackCodeOf } from "../../../lib/site";
import { coverSVG, TRACK_COLORS } from "../../../lib/cover";
import { questOf } from "../../../lib/quest";
import { ICONS } from "../../../lib/icons";

export function getStaticPaths() {
  return allChapters().map((ch) => ({ params: { part: ch.partSlug, chapter: ch.slug }, props: { id: ch.id } }));
}
const { id } = Astro.props as { id: string };
const ch = allChapters().find((c) => c.id === id)!;
const part = partOf(ch);
const track = trackOfChapter(ch);
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;
const status = str(ch.meta.status);
const lessonMode = isReady(ch);
const pre = prerequisites(ch);
const { next } = neighbors(ch);
const data = chapterData(ch);
const partLabel = part.label === "부록" ? "부록" : `${part.label}부`;
const closeHref = track ? `tracks/${track.key}/` : part.url;
const closeLabel = track ? `${track.code} 로드맵` : partLabel;
const goals = goalsOf(ch);
const tk = trackKeyOf(ch);
const [c1, c2] = TRACK_COLORS[tk] ?? TRACK_COLORS.reference;
const exIds = Object.keys(ch.exercises);
const quest = lessonMode ? questOf(ch) : null;
const html = lessonMode ? renderChapter(ch.body, { assetBase: `${base}content-assets/${ch.partSlug}/${ch.slug}/`, fromDir: ch.dir }) : "";

const sectionsOf = (body: string) =>
  body.split(/^## /m).slice(1).map((chunk) => {
    const nl = chunk.indexOf("\n");
    return { title: chunk.slice(0, nl).trim(), body: chunk.slice(nl + 1).trim() };
  });
const FIXED_KIND: Record<string, string> = { "실습": "lab", "실패 사례": "pitfalls", "통과 기준": "pass" };
const outline = lessonMode ? [] : sectionsOf(ch.body).filter((s) => s.title !== "학습 목표" && s.body);
const coverHTML = coverSVG({ id: ch.id, track: tk, code: trackCodeOf(tk), label: ch.label });
const nodeIcon = (k: string) => (ICONS as Record<string, string>)[k] ?? ICONS.read;
---
{lessonMode && quest ? (
  <Shell title={`${ch.label} ${str(ch.meta.title)}`} description={`${str(ch.meta.title)} — ${str(part.meta.title)}`} pageData={data} variant="quest">
    <header class="topbar qtop">
      <a class="btn" href={u(closeHref)} aria-label={`${closeLabel}(으)로 나가기`}><Fragment set:html={ICONS.back} />{closeLabel}</a>
      <div class="qtitle"><span class="n">{ch.label}</span>{str(ch.meta.title)}</div>
      <span class="count" data-q-count>0 / {quest.nodes.length}</span>
      <button class="icon-btn" type="button" data-open-palette aria-label="검색" set:html={ICONS.search} />
      <button class="icon-btn" type="button" data-theme-toggle aria-label="라이트·다크 테마 바꾸기" set:html={ICONS.theme} />
    </header>
    <div class="q-wrap" data-quest data-chapter={ch.id} style={`--t1:${c1};--t2:${c2}`}>
      <aside class="q-left">
        <div class="clay unit">
          <small>{`${track ? `${track.code} ${track.name}` : "부록"} · ${partLabel} ${str(part.meta.title)}`}</small>
          <h1><span class="n">{ch.label}</span>{str(ch.meta.title)}</h1>
          {status !== "done" && <span class="badge">{STATUS_LABEL[status] ?? status}</span>}
        </div>
        {goals.length > 0 && (
          <div class="clay objs">
            <h2>학습 목표</h2>
            <ol>{goals.map((g, i) => <li data-obj={i + 1}><i>{i + 1}</i><span set:html={renderInline(g)} /></li>)}</ol>
          </div>
        )}
        {pre.length > 0 && (
          <div class="clay prereq-card">
            <h2>먼저 읽기</h2>
            <div class="recent">{pre.map((p) => <a class="chip" href={u(p.url)} data-prereq={p.id}><span class="n">{p.label}</span><span>{str(p.meta.title)}</span></a>)}</div>
          </div>
        )}
      </aside>

      <section class="q-mid" aria-label="퀘스트">
        {quest.groups.length > 1 && (
          <div class="sec-tabs" role="tablist" aria-label="구간">
            {quest.groups.map((g, i) => <button type="button" role="tab" data-group={i} aria-selected={i === 0 ? "true" : "false"}><b>{i + 1}</b><span>{g.name}</span></button>)}
          </div>
        )}
        <div class="path" data-path>
          <svg class="trail" aria-hidden="true"></svg>
          {quest.groups.map((g, gi) => (
            <div class="path-group" data-group={gi} hidden={gi !== 0}>
              {g.nodes.map((nid) => {
                const n = quest.nodes.find((x) => x.id === nid)!;
                return (
                  <button type="button" class="node" data-node={n.id} data-kind={n.kind} data-section={n.section} data-quiz={n.quiz} data-objective={n.objective} aria-label={n.name}>
                    <span class="ico" set:html={nodeIcon(n.kind)} /><span class="nm">{n.name}</span>
                  </button>
                );
              })}
            </div>
          ))}
        </div>
      </section>

      <aside class="q-right">
        <div class="clay qprog">
          <h2>이 장의 진행</h2>
          <div class="meter" role="progressbar" aria-label="이 장의 진행" aria-valuemin="0" aria-valuemax="100"><i data-q-meter></i></div>
          <dl>
            <div><dt>단계</dt><dd data-q-k="steps">0/{quest.nodes.length}</dd></div>
            <div><dt>개념 퀴즈</dt><dd data-q-k="quiz">0/{ch.quiz.length}</dd></div>
            <div><dt>연습문제</dt><dd data-q-k="ex">0/{exIds.length}</dd></div>
          </dl>
        </div>
        {exIds.length > 0 && (
          <a class="clay side-link" href={u(ch.url + "lab/")} data-lab-link>
            <span class="ic" set:html={ICONS.lab} />
            <span><b>실습실</b><small>연습문제 {exIds.length}개를 브라우저 안의 데스크톱에서 고치고 채점한다.</small></span>
          </a>
        )}
        {next && (
          <a class="clay side-link" href={u(next.url)}>
            <span class="ic blue" set:html={ICONS.arrow} />
            <span><b>다음 장</b><small>{`${next.label} ${str(next.meta.title)}`}</small></span>
          </a>
        )}
      </aside>
    </div>
    <div class="prose node-store" data-store hidden set:html={html} />
    <script type="application/json" id="quest-data" set:html={JSON.stringify({ ...quest, exIds, labUrl: exIds.length ? u(ch.url + "lab/") : "", nextUrl: next ? u(next.url) : "", nextLabel: next ? `${next.label} ${str(next.meta.title)}` : "", closeUrl: u(closeHref) }).replace(/</g, "\\u003c")} />
  </Shell>
) : (
  <Shell title={`${ch.label} ${str(ch.meta.title)}`} description={`${str(ch.meta.title)} — ${str(part.meta.title)}`} pageData={data} current="tracks">
    <div style="max-width:980px;margin:0 auto">
      <div class="outline-hero">
        <span class="cover" set:html={coverHTML} />
        <div class="page-head" style="margin:0">
          <nav class="crumbs">
            {track && <a href={u(closeHref)}>{`${track.code} ${track.name}`}</a>}
            <span>/</span><a href={u(part.url)}>{`${partLabel} ${str(part.meta.title)}`}</a>
            <span class="badge">{STATUS_LABEL[status] ?? status}</span>
          </nav>
          <h1><span class="muted tabular">{ch.label}</span>{str(ch.meta.title)}</h1>
          {pre.length > 0 && (
            <div class="prereq">
              <span>먼저 읽기</span>
              {pre.map((p) => <a class="chip" href={u(p.url)} data-prereq={p.id}><span class="n">{p.label}</span><span>{str(p.meta.title)}</span></a>)}
            </div>
          )}
        </div>
      </div>
      <section class="outline-grid">
        <div class="tile tile-dark ocard ocard-goals">
          <h2>이 장을 마치면</h2>
          <ol>{goals.map((g) => <li set:html={renderInline(g)} />)}</ol>
        </div>
        {outline.map((s) => (
          <div class:list={["tile", "ocard", FIXED_KIND[s.title] && `ocard-${FIXED_KIND[s.title]}`]}>
            <h3>{s.title}</h3>
            <div set:html={renderMarkdown(s.body, { fromDir: ch.dir })} />
          </div>
        ))}
      </section>
      <div class="tile outline-cta">
        <span>본문을 쓰는 중인 장이다. 다룰 내용과 학습 목표가 먼저 나와 있다.</span>
        <a class="btn" href="https://github.com/pjmbatman/ai-research-roadmap-book/blob/main/CONTRIBUTING.md">집필에 참여하기</a>
        {next && <a class="btn btn-primary" href={u(next.url)}>{`${next.label} ${str(next.meta.title)}`} →</a>}
      </div>
    </div>
  </Shell>
)}
