---
import Shell from "../../layouts/Shell.astro";
import { loadBook, str } from "../../lib/book";
const { parts, config } = loadBook();
const u = (p: string) => import.meta.env.BASE_URL + p;
const layers = new Map((config.layers as any[]).map((l) => [l.level, l]));
const tracks = config.tracks as any[];
const levels = [...new Set(tracks.map((t) => t.layer as number))].sort((a, b) => a - b);
---
<Shell title="트랙과 목차" current="tracks">
  <div class="page">
    <h1 class="page-title">트랙</h1>
    <div data-tabs class="layer-tabs">
      <div class="tabbar">
        {levels.map((lv, i) => <button data-tab={`L${lv}`} data-selected={i === 0 ? "true" : undefined}>L{lv} {layers.get(lv)?.name}</button>)}
      </div>
      {levels.map((lv) => (
        <div data-panel={`L${lv}`} class="track-grid">
          {tracks.filter((t) => t.layer === lv).map((t) => {
            const n = parts.filter((p) => str(p.meta.track) === t.key).reduce((s, p) => s + p.chapters.length, 0);
            return (
              <a class="track-card" href={u(`tracks/${t.key}/`)}>
                <span class="badge badge-code">{t.code}</span>
                <h3>{t.name}</h3>
                <p>{t.question}</p>
                <span class="foot"><span>{n}장</span><span>→</span></span>
              </a>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</Shell>
