---
// 트랙 = 로드맵 (roadmap.sh 구조, ADR 0011 재질): 커버가 있는 머리 + 부(주제 노드) → 장(하위 노드).
// 노드를 누르면 서랍에 학습 목표·선수 지식·상태(학습 중·완료·건너뜀·초기화)·읽기 버튼이 나온다.
import Shell from "../../layouts/Shell.astro";
import { loadBook, allChapters, str } from "../../lib/book";
import { chapterSummary } from "../../lib/site";
import { coverSVG, TRACK_COLORS } from "../../lib/cover";

export function getStaticPaths() {
  return (loadBook().config.tracks as any[]).map((t) => ({ params: { key: t.key }, props: { key: t.key } }));
}
const { key } = Astro.props as { key: string };
const { parts, config } = loadBook();
const t = (config.tracks as any[]).find((x) => x.key === key);
const tparts = parts.filter((p) => str(p.meta.track) === key);
const chapters = tparts.flatMap((p) => p.chapters);
const u = (p: string) => import.meta.env.BASE_URL + p;
const summary = allChapters().map(chapterSummary);
const half = (n: number) => Math.ceil(n / 2);
const [c1, c2] = TRACK_COLORS[key] ?? TRACK_COLORS.reference;
---
<Shell title={`${t.code} ${t.name}`} description={t.question} current="tracks">
  <div class="track-hero">
    <span class="cover" set:html={coverSVG({ id: key, track: key, code: t.code, ratio: 1 })} />
    <div>
      <nav class="crumbs"><a href={u("tracks/")}>트랙</a><span>/</span><span>L{t.layer}</span></nav>
      <h1>{t.name}</h1>
      <p>{t.question}</p>
      <div class="row">
        <div class="progress"><i data-track-progress={key}></i></div>
        <span class="muted tabular" style="font-size:13px">완료 <b data-track-done={key}>0</b> / {chapters.length}</span>
        <div class="rm-legend"><span><i class="ready"></i>본문 있음</span><span><i class="learning"></i>학습 중</span><span><i class="done"></i>완료</span></div>
      </div>
    </div>
  </div>
  <div class="roadmap" data-roadmap style={`--t1:${c1};--t2:${c2}`}>
    {tparts.map((p) => (
      <section class="rm-part">
        <a class="rm-topic" href={u(p.url)}><small>{p.label === "부록" ? "부록" : `${p.label}부`}</small><b>{str(p.meta.title)}</b></a>
        <div class="rm-side left">
          {p.chapters.slice(0, half(p.chapters.length)).map((c) => (
            <button type="button" class="rm-node" data-node={c.id}><span class="n">{c.label}</span><span class="t">{str(c.meta.title)}</span></button>
          ))}
        </div>
        <div class="rm-side right">
          {p.chapters.slice(half(p.chapters.length)).map((c) => (
            <button type="button" class="rm-node" data-node={c.id}><span class="n">{c.label}</span><span class="t">{str(c.meta.title)}</span></button>
          ))}
        </div>
      </section>
    ))}
  </div>
  <script type="application/json" id="chapters-data" set:html={JSON.stringify(summary).replace(/</g, "\\u003c")} />
</Shell>
