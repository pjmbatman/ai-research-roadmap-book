---
import Shell from "../../layouts/Shell.astro";
import { loadBook, str } from "../../lib/book";

export function getStaticPaths() {
  return (loadBook().config.tracks as any[]).map((t) => ({ params: { key: t.key }, props: { key: t.key } }));
}
const { key } = Astro.props as { key: string };
const { parts, config } = loadBook();
const t = (config.tracks as any[]).find((x) => x.key === key);
const tparts = parts.filter((p) => str(p.meta.track) === key);
const chapters = tparts.flatMap((p) => p.chapters);
const u = (p: string) => import.meta.env.BASE_URL + p;
---
<Shell title={`${t.code} ${t.name}`} description={t.question} current="tracks">
  <div class="page" data-track={key} data-track-chapters={JSON.stringify(chapters.map((c) => c.id))}>
    <h1 class="page-title"><span class="badge badge-code">{t.code}</span> {t.name}</h1>
    <div class="bento">
      <div class="tile dark wide"><small>핵심 질문</small><div class="q">{t.question}</div></div>
      <div class="tile"><small>읽은 장</small><div class="big"><span data-track-done>0</span><span class="of">/{chapters.length}</span></div><div class="meter"><i data-track-meter></i></div></div>
      <div class="tile"><small>도달 목표</small><div class="o">{t.outcome}</div></div>
    </div>
    <div data-tabs class="part-tabs">
      <div class="tabbar">
        {tparts.map((p, i) => <button data-tab={p.slug} data-selected={i === 0 ? "true" : undefined}>{p.label === "부록" ? "부록" : `${p.label}부`} {str(p.meta.title)}</button>)}
      </div>
      {tparts.map((p) => (
        <div data-panel={p.slug} class="part-block">
          <ul class="ch-list">
            {p.chapters.map((c) => (
              <li><a href={u(c.url)} data-chapter-link={c.id}><span class="n">{c.label}</span><span>{str(c.meta.title)}</span>
                <span class="st">{["draft", "review", "done"].includes(str(c.meta.status)) && <span class="badge badge-ready">읽기</span>}</span></a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</Shell>
