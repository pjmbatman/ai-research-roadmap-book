---
// 내 진도 (shadcn/ui 대시보드): 숫자 카드 4개 + 트랙별 진행 + 최근에 본 장 + 기록 옮기기.
import Shell from "../layouts/Shell.astro";
import { loadBook, allChapters } from "../lib/book";
import { chapterSummary } from "../lib/site";
const { config } = loadBook();
const data = {
  tracks: (config.tracks as any[]).filter((t) => t.layer < 9).map((t) => ({ key: t.key, code: t.code, name: t.name })),
  chapters: allChapters().map(chapterSummary),
};
---
<Shell title="내 진도" current="progress">
  <div class="container" data-progress-page>
    <div class="page-head">
      <h1>내 진도</h1>
      <p>로그인 없이 이 브라우저에 저장된다. 다른 기기로 옮기려면 내보내기를 쓴다.</p>
    </div>
    <div class="stats">
      <div class="card stat"><small>완료한 장</small><div class="big"><span data-k="done">0</span><span class="of" data-k="done-of"></span></div></div>
      <div class="card stat"><small>학습 중</small><div class="big"><span data-k="learning">0</span></div></div>
      <div class="card stat"><small>맞힌 퀴즈</small><div class="big"><span data-k="quiz">0</span><span class="of" data-k="quiz-of"></span></div></div>
      <div class="card stat"><small>통과한 연습문제</small><div class="big"><span data-k="ex">0</span><span class="of" data-k="ex-of"></span></div></div>
    </div>
    <div class="two-col">
      <div class="card panel"><h2>트랙</h2><div class="track-rows" data-k="tracks"></div></div>
      <div class="card panel">
        <h2>최근에 본 장</h2>
        <div class="recent" data-k="recent"></div>
        <h2 style="margin-top:8px">기록 옮기기</h2>
        <div class="panel-actions">
          <button class="btn" type="button" data-act="export">내보내기</button>
          <label class="btn" style="cursor:pointer">가져오기<input type="file" accept="application/json" data-act="import" hidden /></label>
          <button class="btn btn-ghost" type="button" data-act="reset">모두 지우기</button>
          <span data-k="msg" aria-live="polite" class="muted" style="font-size:13px"></span>
        </div>
      </div>
    </div>
  </div>
  <script type="application/json" id="progress-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
</Shell>
