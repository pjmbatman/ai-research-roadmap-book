---
import Shell from "../layouts/Shell.astro";
import { loadBook, allChapters, str } from "../lib/book";
const { parts, config } = loadBook();
const passCount = (body: string) => {
  const m = /^## 통과 기준\s*\n([\s\S]*?)(?=^## |$(?![\s\S]))/m.exec(body);
  return m ? m[1].split("\n").filter((l) => l.startsWith("- ")).length : 0;
};
const data = {
  tracks: (config.tracks as any[]).map((t) => ({ key: t.key, code: t.code, name: t.name })),
  chapters: allChapters().map((c) => ({
    id: c.id, label: c.label, title: str(c.meta.title), url: c.url, status: str(c.meta.status),
    track: str(parts.find((p) => p.slug === c.partSlug)?.meta.track),
    quiz: c.quiz.length, ex: Object.keys(c.exercises).length, checks: passCount(c.body),
  })),
};
---
<Shell title="내 진도" current="progress">
  <div class="page" data-progress-page>
    <h1 class="page-title">내 진도</h1>
    <div class="bento">
      <div class="tile dark"><small>읽은 장</small><div class="big"><span data-k="visited">0</span><span class="of" data-k="visited-of"></span></div></div>
      <div class="tile"><small>퀴즈</small><div class="big"><span data-k="quiz">0</span><span class="of" data-k="quiz-of"></span></div></div>
      <div class="tile"><small>연습문제</small><div class="big"><span data-k="ex">0</span><span class="of" data-k="ex-of"></span></div></div>
      <div class="tile"><small>통과 기준</small><div class="big"><span data-k="checks">0</span><span class="of" data-k="checks-of"></span></div></div>
      <div class="tile wide"><small>트랙</small><div class="tile-track" data-k="tracks"></div></div>
      <div class="tile wide"><small>최근</small><div class="recent" data-k="recent"></div>
        <div class="tile-actions">
          <button class="btn" type="button" data-act="export">내보내기</button>
          <label class="btn">가져오기<input type="file" accept="application/json" data-act="import" hidden /></label>
          <button class="btn btn-ghost" type="button" data-act="reset">지우기</button>
          <span data-k="msg" aria-live="polite"></span>
        </div>
      </div>
    </div>
    <script type="application/json" id="progress-data" set:html={JSON.stringify(data).replace(/</g, "\\u003c")} />
  </div>
</Shell>
