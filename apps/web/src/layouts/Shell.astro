---
// 공통 틀 (editorial/design-system.md §3, ADR 0010).
// 일반 화면: shadcn/ui 문서 사이트식 머리(로고 · 메뉴 · 검색 · 테마). 화면 아래 dock은 쓰지 않는다.
// 레슨 화면(본문이 있는 장): Brilliant·Duolingo식 레슨 바(닫기 · 진행 막대 · k/N · 단계 목록)와 아래 고정 이전·계속 막대.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Lesson { closeHref: string; closeLabel: string; nextHref?: string; nextLabel?: string }
interface Props { title: string; description?: string; current?: string; pageData?: unknown; lesson?: Lesson }
const { title, description = "과학 문제를 AI로 정의하고 검증하는 연구자를 위한 오픈소스 로드맵", current = "", pageData, lesson } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;
const fullTitle = title === "AI for Science 로드맵" ? title : `${title} · AI for Science 로드맵`;
const nav = [
  { key: "map", href: "map/", label: "로드맵" },
  { key: "tracks", href: "tracks/", label: "트랙" },
  { key: "progress", href: "progress/", label: "내 진도" },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem("roadmap:theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body data-base={base} class:list={{ "lesson-mode": !!lesson }}>
    {lesson ? (
      <header class="lesson-bar">
        <div class="inner">
          <a class="icon-btn" href={u(lesson.closeHref)} aria-label={`${lesson.closeLabel}(으)로 나가기`} title={lesson.closeLabel}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </a>
          <div class="progress" role="progressbar" aria-label="이 장의 진행" aria-valuemin="0" aria-valuemax="100" data-lesson-progress><i></i></div>
          <span class="count tabular" data-stepcount></span>
          <button type="button" class="icon-btn" data-lesson-menu-toggle aria-expanded="false" aria-label="단계 목록">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
          <div class="lesson-menu" data-lesson-menu hidden>
            <h4>단계</h4>
            <ol data-steplist></ol>
            <div class="meta">
              <span>진도 <b data-chapter-pct>0%</b></span>
              <div class="progress"><i data-chapter-meter></i></div>
              <span><button type="button" class="btn btn-sm btn-ghost" data-open-palette>검색</button> <button type="button" class="btn btn-sm btn-ghost" data-theme-toggle>테마</button></span>
            </div>
          </div>
        </div>
      </header>
    ) : (
      <header class="site-header">
        <div class="inner">
          <a class="brand" href={u("")}><span class="brand-mark" aria-hidden="true">AI</span>AI for Science 로드맵</a>
          <nav class="site-nav" aria-label="주요 메뉴">
            {nav.map((n) => <a href={u(n.href)} aria-current={current === n.key ? "page" : undefined}>{n.label}</a>)}
          </nav>
          <div class="header-actions">
            <button class="search-trigger" type="button" data-open-palette aria-label="검색"><span>장·트랙 검색…</span><kbd>⌘K</kbd></button>
            <button class="icon-btn" type="button" data-theme-toggle aria-label="라이트·다크 테마 바꾸기">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9z"/></svg>
            </button>
          </div>
        </div>
      </header>
    )}

    <main><slot /></main>

    {lesson ? (
      <nav class="lesson-actions" aria-label="단계 이동">
        <div class="inner">
          <button type="button" class="btn btn-lg" data-prev>이전</button>
          <button type="button" class="btn btn-primary btn-lg" data-next data-next-chapter={lesson.nextHref ? u(lesson.nextHref) : undefined} data-next-chapter-label={lesson.nextLabel}>계속</button>
        </div>
      </nav>
    ) : (
      <footer class="site-footer">
        <div class="inner">
          <span>코드 MIT · 본문 CC BY 4.0</span>
          <a href="https://github.com/pjmbatman/ai-research-roadmap-book">GitHub</a>
        </div>
      </footer>
    )}

    <div class="palette" data-palette role="dialog" aria-modal="true" aria-label="검색">
      <div class="palette-box">
        <label class="sr-only" for="palette-input">장·부·트랙 검색</label>
        <input id="palette-input" type="search" placeholder="장 제목이나 번호(예: 7.2)로 검색" autocomplete="off" />
        <ul role="listbox" aria-label="검색 결과"></ul>
      </div>
    </div>

    {pageData && <script type="application/json" id="page-data" set:html={JSON.stringify(pageData).replace(/</g, "\\u003c")} />}
    <script>
      import "../client/main";
    </script>
  </body>
</html>
