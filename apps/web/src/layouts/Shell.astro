---
// 공통 틀 (design-system.md §3, ADR 0012).
// default: 위 막대(로고 · 메뉴 알약 · 검색 · 테마). 좁은 화면에서는 메뉴 알약이 아래 탭 막대로 내려간다.
// quest: 퀘스트 화면이 자기 위 막대를 그린다. lab: 실습실(데스크톱)이 화면 전체를 쓴다.
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
import { ICONS } from "../lib/icons";

interface Props { title: string; description?: string; current?: string; pageData?: unknown; variant?: "default" | "quest" | "lab" }
const { title, description = "과학 문제를 AI로 정의하고 검증하는 연구자를 위한 오픈소스 로드맵", current = "", pageData, variant = "default" } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;
const fullTitle = title === "AI for Science 로드맵" ? title : `${title} · AI for Science 로드맵`;
const nav = [
  { key: "home", href: "", label: "홈", icon: ICONS.home },
  { key: "map", href: "map/", label: "로드맵", icon: ICONS.map },
  { key: "tracks", href: "tracks/", label: "트랙", icon: ICONS.tracks },
  { key: "progress", href: "progress/", label: "내 진도", icon: ICONS.progress },
];
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem("roadmap:theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body data-base={base} class:list={{ "has-nav": variant === "default", "lab-body": variant === "lab", "quest-body": variant === "quest" }}>
    {variant === "default" && (
      <header class="topbar">
        <a class="brand" href={u("")}><span class="brand-mark" aria-hidden="true"></span><span class="txt">AI for Science</span></a>
        <nav class="nav" aria-label="주요 메뉴">
          {nav.map((n) => <a href={u(n.href)} aria-current={current === n.key ? "page" : undefined}><Fragment set:html={n.icon} /><span>{n.label}</span></a>)}
        </nav>
        <button class="search-field" type="button" data-open-palette aria-label="검색">
          <Fragment set:html={ICONS.search} /><span>장, 트랙, 개념 검색</span><kbd>⌘K</kbd>
        </button>
        <button class="icon-btn" type="button" data-theme-toggle aria-label="라이트·다크 테마 바꾸기" title="테마" set:html={ICONS.theme} />
      </header>
    )}
    {variant === "default" ? (
      <main class="page"><slot /></main>
    ) : (
      <slot />
    )}
    {variant === "default" && (
      <footer class="site-footer">
        <span>코드 MIT · 본문 CC BY 4.0</span>
        <a href="https://github.com/pjmbatman/ai-research-roadmap-book">GitHub</a>
      </footer>
    )}

    <div class="palette" data-palette role="dialog" aria-modal="true" aria-label="검색">
      <div class="palette-box">
        <label class="sr-only" for="palette-input">장·부·트랙 검색</label>
        <input id="palette-input" type="search" placeholder="장 제목이나 번호(예: 7.2)로 검색" autocomplete="off" />
        <ul role="listbox" aria-label="검색 결과"></ul>
      </div>
    </div>

    {pageData && <script type="application/json" id="page-data" set:html={JSON.stringify(pageData).replace(/</g, "\\u003c")} />}
    <script>
      import "../client/main";
    </script>
  </body>
</html>
