---
import "pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/600.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";

interface Props { title: string; description?: string; current?: string; pageData?: unknown }
const { title, description = "과학 문제를 AI로 정의하고, 검증하고, 재현 가능하게 전달하는 연구자를 위한 오픈소스 로드맵", current = "", pageData } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p: string) => base + p;
const fullTitle = title === "AI for Science 로드맵" ? title : `${title} · AI for Science 로드맵`;
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={u("favicon.svg")} type="image/svg+xml" />
    <script is:inline>
      try { const t = localStorage.getItem("roadmap:theme"); if (t === "dark" || t === "light") document.documentElement.dataset.theme = t; } catch (e) {}
    </script>
  </head>
  <body data-base={base}>
    <header class="topbar">
      <a class="brand" href={u("")}><span class="brand-mark" aria-hidden="true"></span>AI for Science 로드맵</a>
      <div class="topbar-actions">
        <button class="kbd-hint" type="button" data-open-palette aria-label="검색"><kbd>⌘</kbd><kbd>K</kbd></button>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <a href="https://github.com/pjmbatman/ai-research-roadmap-book">GitHub</a>
      <span>MIT · CC BY 4.0</span>
    </footer>

    <nav class="dock" aria-label="주요 메뉴">
      <a href={u("")} data-tip="홈" aria-current={current === "home" ? "page" : undefined} aria-label="홈">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>
      </a>
      <a href={u("map/")} data-tip="로드맵 지도" aria-current={current === "map" ? "page" : undefined} aria-label="로드맵 지도">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 7l4 9M17 7l-4 9M7 6h10"/></svg>
      </a>
      <a href={u("tracks/")} data-tip="트랙과 목차" aria-current={current === "tracks" ? "page" : undefined} aria-label="트랙과 목차">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/></svg>
      </a>
      <a href={u("progress/")} data-tip="내 진도" aria-current={current === "progress" ? "page" : undefined} aria-label="내 진도">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 20V10M10 20V4M16 20v-7M22 20H2"/></svg>
      </a>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" data-open-palette data-tip="검색 ⌘K" aria-label="검색">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      </button>
      <button type="button" data-theme-toggle data-tip="테마 바꾸기" aria-label="라이트·다크 테마 바꾸기">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </nav>

    <div class="palette" data-palette role="dialog" aria-modal="true" aria-label="검색">
      <div class="palette-box">
        <label class="sr-only" for="palette-input">장·부·트랙 검색</label>
        <input id="palette-input" type="search" placeholder="검색" autocomplete="off" />
        <ul role="listbox" aria-label="검색 결과"></ul>
      </div>
    </div>

    {pageData && <script type="application/json" id="page-data" set:html={JSON.stringify(pageData).replace(/</g, "\\u003c")} />}
    <script>
      import "../client/main";
    </script>
  </body>
</html>
